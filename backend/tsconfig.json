{
  "compilerOptions": {
    /* Path Resolution */
    "baseUrl": ".",
    "paths": {
      "../generated/prisma/client.js": ["./src/generated/prisma/client"]
    },

    /* Basic Options */
    "rootDir": "./",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false, 

    /* Emit */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Interop & Modern Tools */
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true 
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "api/**/*", "src/generated/**/*"]
}
